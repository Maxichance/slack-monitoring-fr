# Copier ce fichier en .env et renseigner les valeurs (voir le guide, section 0.2).

# Jeton du bot (api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=

# URL de base de l'espace de travail, ex. https://app.slack.com/client/TXXXXXXXXXX
SLACK_WORKSPACE_URL=

# ID du canal qui reçoit les logs du projet (commence par C)
SLACK_CHANNEL_ID=

SLACK_ENABLED=true

# Facultatif : ID du membre à mentionner sur les alertes critiques (commence par U)
SLACK_MENTION_ID=
